From: OpenAI ChatGPT/Codex (GPT-5)
Subject: net: phy: as21xxx: declare model-specific link features

The AS21xxx driver uses firmware-backed Clause 45 access and the BPI-R4
Pro 8X runtime shows generic feature discovery can leave the PHY with no
speed-capability bits in phydev->supported.  phylink then rejects the
vendor-style GMAC1/AS21xxx 10GBase-R topology before the PHY can attach:

  validation of ... support ...00006040 ... failed: -EINVAL
  mtk_open: could not attach PHY: -22

Follow the vendor AS21xxx driver direction of providing an explicit
.get_features callback, but keep the supported NBASE-T/10G bits
model-specific using the AS21xxx ID legend already present in the
driver.  This keeps the vendor hardware organization intact while
avoiding a blind "all AS21xxx are 10G" declaration.

Source: vendor AS21xxx package
  refs/vendor/bpi-r4pro-8x-openwrt24.10/package/kernel/as21xxx/source/as21xxx.c
Behavior source: vendor .get_features callback plus local runtime
evidence from BPI-R4 Pro 8X Phase 9.8 testing.
Adapted-for: ImmortalWrt 25.12 / Linux 6.12.91 mediatek/filogic
Adapted-by: OpenAI ChatGPT/Codex (GPT-5)
---
 drivers/net/phy/as21xxx.c | 61 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 61 insertions(+)

--- a/drivers/net/phy/as21xxx.c
+++ b/drivers/net/phy/as21xxx.c
@@ -734,6 +734,57 @@ static int as21xxx_read_c22_lpa(struct p
 	return 0;
 }
 
+static int as21xxx_get_features(struct phy_device *phydev)
+{
+	linkmode_set_bit_array(phy_basic_ports_array,
+			       ARRAY_SIZE(phy_basic_ports_array),
+			       phydev->supported);
+
+	linkmode_set_bit(ETHTOOL_LINK_MODE_Autoneg_BIT,
+			 phydev->supported);
+
+	/* The vendor driver explicitly advertises full-duplex copper modes
+	 * and clears half-duplex/10M support. Keep that behavior, but limit
+	 * 2.5G/5G/10G according to the AS21xxx model ID legend.
+	 */
+	linkmode_clear_bit(ETHTOOL_LINK_MODE_10baseT_Half_BIT,
+			   phydev->supported);
+	linkmode_clear_bit(ETHTOOL_LINK_MODE_10baseT_Full_BIT,
+			   phydev->supported);
+	linkmode_clear_bit(ETHTOOL_LINK_MODE_100baseT_Half_BIT,
+			   phydev->supported);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_100baseT_Full_BIT,
+			 phydev->supported);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT,
+			 phydev->supported);
+
+	switch (phydev->phy_id) {
+	case PHY_ID_AS21011JB1:
+	case PHY_ID_AS21011PB1:
+	case PHY_ID_AS21010JB1:
+	case PHY_ID_AS21010PB1:
+		linkmode_set_bit(ETHTOOL_LINK_MODE_10000baseT_Full_BIT,
+				 phydev->supported);
+		fallthrough;
+	case PHY_ID_AS21511JB1:
+	case PHY_ID_AS21511PB1:
+	case PHY_ID_AS21510JB1:
+	case PHY_ID_AS21510PB1:
+		linkmode_set_bit(ETHTOOL_LINK_MODE_5000baseT_Full_BIT,
+				 phydev->supported);
+		fallthrough;
+	case PHY_ID_AS21210JB1:
+	case PHY_ID_AS21210PB1:
+		linkmode_set_bit(ETHTOOL_LINK_MODE_2500baseT_Full_BIT,
+				 phydev->supported);
+		break;
+	default:
+		return -ENODEV;
+	}
+
+	return 0;
+}
