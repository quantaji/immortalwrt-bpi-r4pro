+static void mtk_eth_set_dsa_pppq_offset(struct mtk_eth *eth)
+{
+#if IS_ENABLED(CONFIG_NET_DSA)
+	struct net_device *dev;
+	int i, offset = 0;
+
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		dev = eth->netdev[i];
+		eth->pppq_ofs[i] = 0;
+
+		if (!dev || !netdev_uses_dsa(dev))
+			continue;
+
+		eth->pppq_ofs[i] = offset;
+		offset += hweight32(dsa_user_ports(dev->dsa_ptr->ds));
+	}
+
+	eth->dsa_user_count = offset;
+#endif
+}
+
+static void mtk_eth_set_dsa_user_idx(struct mtk_eth *eth,
+				     struct net_device *dev)
+{
+#if IS_ENABLED(CONFIG_NET_DSA)
+	const struct dsa_port *dp;
+	struct dsa_switch *ds;
+	struct mtk_mac *mac;
+	struct net_device *conduit;
+	int p, cnt = 0;
+
+	if (!dsa_user_dev_check(dev))
+		return;
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR(dp) || !dp->cpu_dp)
+		return;
+
+	conduit = dsa_port_to_conduit(dp);
+	if (!conduit)
+		return;
+
+	mac = netdev_priv(conduit);
+	memset(mac->dsa_user_idx, 0, sizeof(mac->dsa_user_idx));
+
+	ds = dp->cpu_dp->ds;
+	for (p = 0; p < ds->num_ports; p++) {
+		if (!dsa_is_user_port(ds, p))
+			continue;
+
+		dp = dsa_to_port(ds, p);
+		if (dp->index < ARRAY_SIZE(mac->dsa_user_idx))
+			mac->dsa_user_idx[dp->index] = cnt;
+
+		cnt++;
+	}
+#endif
+}
+
+static unsigned int mtk_dsa_user_queue(struct mtk_eth *eth,
+				       struct mtk_mac *mac,
+				       unsigned int dsa_port)
+{
+	if (dsa_port >= ARRAY_SIZE(mac->dsa_user_idx))
+		return mac->id;
+
+	return MTK_MAX_DEVS + eth->pppq_ofs[mac->id] +
+	       mac->dsa_user_idx[dsa_port];
+}
