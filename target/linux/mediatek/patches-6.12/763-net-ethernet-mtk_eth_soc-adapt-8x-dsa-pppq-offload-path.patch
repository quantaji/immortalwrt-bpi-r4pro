+static int
+mtk_ppe_internal_debugfs_read_qos(struct seq_file *m, void *private)
+{
+	struct mtk_eth *eth = m->private;
+
+	switch (eth->qos_toggle) {
+	case 0:
+		seq_puts(m, "HQoS disabled\n");
+		break;
+	case 1:
+		seq_puts(m, "HQoS enabled\n");
+		break;
+	case 2:
+		seq_puts(m, "PPPQ enabled\n");
+		break;
+	case 3:
+		seq_puts(m, "adaptive PPPQ enabled\n");
+		break;
+	default:
+		seq_printf(m, "unknown mode %u\n", eth->qos_toggle);
+		break;
+	}
+
+	return 0;
+}
+
+static int
+mtk_ppe_internal_debugfs_open_qos(struct inode *inode, struct file *file)
+{
+	return single_open(file, mtk_ppe_internal_debugfs_read_qos,
+			   inode->i_private);
+}
+
+static ssize_t
+mtk_ppe_internal_debugfs_write_qos(struct file *file,
+				   const char __user *user_buf,
+				   size_t count, loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct mtk_eth *eth = m->private;
+	char buf[8];
+	size_t len;
+
+	len = min_t(size_t, count, sizeof(buf) - 1);
+	if (copy_from_user(buf, user_buf, len))
+		return -EFAULT;
+
+	buf[len] = '\0';
+
+	switch (buf[0]) {
+	case '0':
+		pr_info("HQoS is going to be disabled!\n");
+		eth->qos_toggle = 0;
+		break;
+	case '1':
+		pr_info("HQoS mode is going to be enabled!\n");
+		eth->qos_toggle = 1;
+		break;
+	case '2':
+		pr_info("Per-port-per-queue mode is going to be enabled!\n");
+		pr_info("PPPQ use qid 3~14 (scheduler 0).\n");
+		eth->qos_toggle = 2;
+		break;
+	case '3':
+		pr_info("Adaptive per-port-per-queue mode is going to be enabled!\n");
+		pr_info("PPPQ use qid 3~14 (scheduler 0).\n");
+		eth->qos_toggle = 3;
+		eth->qdma_shaper.threshold = 6000;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return count;
+}
+
+static const struct file_operations mtk_ppe_internal_debugfs_qos_fops = {
+	.open = mtk_ppe_internal_debugfs_open_qos,
+	.read = seq_read,
+	.write = mtk_ppe_internal_debugfs_write_qos,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
