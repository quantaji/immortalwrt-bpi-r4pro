From: OpenAI ChatGPT/Codex (GPT-5) <codex@openai.com>
Subject: [PATCH] net: phy: as21xxx: match IPC replies to the active command

BPI-R4 Pro 8X diagnostic runtime proved that the remaining AS21xxx
-ETIMEDOUT reports were not a generic firmware-busy condition:

  cmd=0x8081 cmd_opcode=0x01 expected_parity=1
  sts=0x01a4 sts_opcode=0x1a sts_status=0x4 sts_parity=0 sts_size=0

The command being waited for is IPC_CMD_INFO / firmware-version read,
but the status register still reports the previous IPC_CMD_CFG_PARAM
success.  The existing wait helper only checks parity plus non-busy
status, so it can either time out on a stale command with the wrong
parity or later treat a stale zero-length success as an empty firmware
version.

Make the IPC wait path verify that non-READY replies belong to the
current command opcode.  Keep READY as a valid completion only for the
NOOP parity-sync command.  Also move IPC data-register writes under the
IPC mutex and check ret_data, not data, before receiving returned data.

Finally, follow the vendor 24.10 sequencing more closely by not sending
DPC_RA / IPC_CMD_CFG_PARAM from probe.  The vendor driver performs the
runtime readiness check first and only sends DPC_RA from config_init for
USXGMII.  Keeping CFG_PARAM out of probe avoids leaving a CFG_PARAM
success status immediately before phylib config_init polls firmware
version.

Runtime evidence: BPI-R4 Pro 8X r0+37898-59b64b53ce diagnostic log and
r0+37899-d1d992ce41 fixed-image validation.
Vendor sequencing source: Banana Pi BPI-R4 Pro 8X OpenWrt 24.10
as21xxx.c as21xxx_probe() and as21xxx_config_init().

Diagnosed-by: OpenAI ChatGPT/Codex (GPT-5)
Signed-off-by: OpenAI ChatGPT/Codex (GPT-5) <codex@openai.com>
---
 drivers/net/phy/as21xxx.c | 59 +++++++++++++++++++++++++++++---------
 1 file changed, 46 insertions(+), 13 deletions(-)

--- a/drivers/net/phy/as21xxx.c
+++ b/drivers/net/phy/as21xxx.c
@@ -478,30 +478,41 @@
 	return 0;
 }
 
-static bool aeon_ipc_ready(u16 val, bool parity_status)
+static bool aeon_ipc_ready(u16 val, u16 cmd, bool parity_status)
 {
-	u16 status;
+	u16 cmd_opcode = FIELD_GET(AEON_IPC_CMD_OPCODE, cmd);
+	u16 status, sts_opcode;
 
 	if (FIELD_GET(AEON_IPC_STS_PARITY, val) != parity_status)
 		return false;
 
 	status = val & AEON_IPC_STS_STATUS;
 
-	return status != AEON_IPC_STS_STATUS_RCVD &&
-	       status != AEON_IPC_STS_STATUS_PROCESS &&
-	       status != AEON_IPC_STS_STATUS_BUSY;
+	if (status == AEON_IPC_STS_STATUS_RCVD ||
+	    status == AEON_IPC_STS_STATUS_PROCESS ||
+	    status == AEON_IPC_STS_STATUS_BUSY)
+		return false;
+
+	if (status == AEON_IPC_STS_STATUS_READY)
+		return cmd_opcode == IPC_CMD_NOOP;
+
+	sts_opcode = FIELD_GET(AEON_IPC_STS_OPCODE, val);
+
+	return sts_opcode == cmd_opcode;
 }
 
-static int aeon_ipc_wait_cmd(struct phy_device *phydev, bool parity_status)
+static int aeon_ipc_wait_cmd(struct phy_device *phydev, u16 cmd,
+			     bool parity_status)
 {
 	u16 val;
 
 	/* Exit condition logic:
 	 * - Wait for parity bit equal
-	 * - Wait for status success, error OR ready
+	 * - Wait for the active command opcode on success or error
+	 * - Accept ready only for NOOP parity sync
 	 */
 	return phy_read_mmd_poll_timeout(phydev, MDIO_MMD_VEND1, VEND1_IPC_STS, val,
-					 aeon_ipc_ready(val, parity_status),
+					 aeon_ipc_ready(val, cmd, parity_status),
 					 AEON_IPC_DELAY, AEON_IPC_TIMEOUT, false);
 }
 
@@ -536,7 +547,7 @@
 	if (!ret_sts)
 		return 0;
 
-	ret = aeon_ipc_wait_cmd(phydev, curr_parity);
+	ret = aeon_ipc_wait_cmd(phydev, cmd, curr_parity);
 	if (ret)
 		return ret;
 
@@ -571,15 +582,21 @@
 	if (data_len > AEON_IPC_DATA_MAX)
 		return -EINVAL;
 
-	for (i = 0; i < data_len / sizeof(u16); i++)
-		phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_IPC_DATA(i),
-			      data[i]);
+	if (data_len && !data)
+		return -EINVAL;
+
+	mutex_lock(&priv->ipc_lock);
+
+	for (i = 0; i < data_len / sizeof(u16); i++) {
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND1, VEND1_IPC_DATA(i),
+				    data[i]);
+		if (ret)
+			goto out;
+	}
 
 	cmd = FIELD_PREP(AEON_IPC_CMD_SIZE, data_len) |
 	      FIELD_PREP(AEON_IPC_CMD_OPCODE, opcode);
 
-	mutex_lock(&priv->ipc_lock);
-
 	ret = aeon_ipc_send_cmd(phydev, priv, cmd, &ret_sts);
 	if (ret) {
 		phydev_err(phydev, "failed to send ipc msg for %x: %d\n",
@@ -587,7 +604,7 @@
 		goto out;
 	}
 
-	if (!data)
+	if (!ret_data)
 		goto out;
 
 	if ((ret_sts & AEON_IPC_STS_STATUS) == AEON_IPC_STS_STATUS_ERROR) {
@@ -692,6 +709,18 @@
 	return 0;
 }
 
+static int aeon_ipc_get_fw_version_synced(struct phy_device *phydev)
+{
+	struct as21xxx_priv *priv = phydev->priv;
+	int ret;
+
+	ret = aeon_ipc_sync_parity(phydev, priv);
+	if (ret)
+		return ret;
+
+	return aeon_ipc_get_fw_version(phydev);
+}
+
 static int aeon_dpc_ra_enable(struct phy_device *phydev)
 {
 	u16 data[2];
@@ -705,14 +734,9 @@
 
 static int aeon_wait_reset_complete(struct phy_device *phydev)
 {
-	struct as21xxx_priv *priv = phydev->priv;
 	int ret;
 
-	ret = aeon_ipc_sync_parity(phydev, priv);
-	if (ret)
-		return ret;
-
-	return read_poll_timeout(aeon_ipc_get_fw_version, ret,
+	return read_poll_timeout(aeon_ipc_get_fw_version_synced, ret,
 				 ret == 0, AEON_IPC_DELAY,
 				 AEON_IPC_TIMEOUT, false, phydev);
 }
@@ -802,7 +826,7 @@
 	if (ret)
 		return ret;
 
-	return aeon_dpc_ra_enable(phydev);
+	return 0;
 }
 
 static int as21xxx_read_link(struct phy_device *phydev, int *bmcr)
