From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sat, 6 Jun 2026 00:00:00 +0000
Subject: [PATCH] net: ethernet: mtk_wed: apply vendor SER and IRQ fixes

The official BPI-R4 Pro 8X vendor tree carries WED fixes for MT7988/Wi-Fi
offload reset behavior:

- skip unallocated WDMA RX rings during reset
- reset WDMA RX prefetch indices/FIFO after SER
- avoid treating TKID_WO_PYLD as a WED error on v3 and producing false alarms

Vendor sources:
refs/vendor/bpi-r4pro-8x-openwrt24.10/target/linux/mediatek/patches-6.6/
999-3023-fix-wdma-rx-hang-on-wed1-after-SER.patch
999-3034-refactor-mtk_wed_irq_get-to-avoid-wed-status-false-a.patch

Adapted for ImmortalWrt 25.12 / Linux 6.12 by OpenAI ChatGPT/Codex (GPT-5).

Signed-off-by: Rex Lu <rex.lu@mediatek.com>
Signed-off-by: Codex <codex@local>
---
 drivers/net/ethernet/mediatek/mtk_wed.c | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/mediatek/mtk_wed.c
+++ b/drivers/net/ethernet/mediatek/mtk_wed.c
@@ -250,7 +250,7 @@ mtk_wdma_rx_reset(struct mtk_wed_device
 	wdma_w32(dev, MTK_WDMA_RESET_IDX, 0);
 
 	for (i = 0; i < ARRAY_SIZE(dev->rx_wdma); i++) {
-		if (dev->rx_wdma[i].desc)
+		if (!dev->rx_wdma[i].desc)
 			continue;
 
 		wdma_w32(dev,
@@ -1808,6 +1808,21 @@ mtk_wed_reset_dma(struct mtk_wed_device
 			wed_clr(dev, MTK_WED_WDMA_RX_PREF_CFG,
 				MTK_WED_WDMA_RX_PREF_DDONE2_EN);
 
+			/* Reset prefetch index */
+			wed_set(dev, MTK_WED_WDMA_RX_PREF_CFG,
+				MTK_WED_WDMA_RX_PREF_RX0_SIDX_CLR |
+				MTK_WED_WDMA_RX_PREF_RX1_SIDX_CLR);
+
+			wed_clr(dev, MTK_WED_WDMA_RX_PREF_CFG,
+				MTK_WED_WDMA_RX_PREF_RX0_SIDX_CLR |
+				MTK_WED_WDMA_RX_PREF_RX1_SIDX_CLR);
+
+			/* Reset prefetch FIFO */
+			wed_w32(dev, MTK_WED_WDMA_RX_PREF_FIFO_CFG,
+				MTK_WED_WDMA_RX_PREF_FIFO_RX0_CLR |
+				MTK_WED_WDMA_RX_PREF_FIFO_RX1_CLR);
+			wed_w32(dev, MTK_WED_WDMA_RX_PREF_FIFO_CFG, 0);
+
 			/* 2. Reset dma index */
 			wed_w32(dev, MTK_WED_WDMA_RESET_IDX,
 				MTK_WED_WDMA_RESET_IDX_RX_ALL);
@@ -2626,8 +2641,7 @@ mtk_wed_irq_get(struct mtk_wed_device *
 	u32 val, ext_mask;
 
 	if (mtk_wed_is_v3_or_greater(dev->hw))
-		ext_mask = MTK_WED_EXT_INT_STATUS_RX_DRV_COHERENT |
-			   MTK_WED_EXT_INT_STATUS_TKID_WO_PYLD;
+		ext_mask = MTK_WED_EXT_INT_STATUS_RX_DRV_COHERENT;
 	else
 		ext_mask = MTK_WED_EXT_INT_STATUS_ERROR_MASK;
 
